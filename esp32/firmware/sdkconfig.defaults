# 本文件对应本地原理图中的 GD25Q256：256 Mbit 即 32 MiB QIO Flash。
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 使用本工程 partitions.csv，保留工厂镜像、双 OTA、故障转储和 LittleFS。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 使用 8 MiB Octal PSRAM；字体、LVGL 绘制缓冲和历史列表优先放 PSRAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# CPU 峰值 240 MHz；电源管理按任务负载在 40~240 MHz 间动态调整。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# 启用 QMI8658 GPIO21 EXT1 Deep-sleep 唤醒；40 mg/4 样本只是原配电池样机初值，量产前须做佩戴与携带校准。
CONFIG_BOARD_ENABLE_QMI_DEEP_WAKE=y

# 1 kHz tick 让 30 ms 马达脉冲、LVGL 动画和 BLE 超时具有毫秒级调度粒度。
CONFIG_FREERTOS_HZ=1000

# 只启用低功耗 NimBLE，不启用经典蓝牙；首版设备只允许一个 PC 连接。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# v1 只使用 BLE；关闭 Wi-Fi，且 MINIMAL_BUILD 不把未依赖的 OpenThread 组件加入配置树，避免无业务流量的射频/协议栈占用 Flash、RAM 和电池。
CONFIG_ESP_WIFI_ENABLED=n

# LVGL 9 使用 FreeRTOS 和 C 标准库；只启用产品所需字体，减少 Flash 与启动时间。
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
# 产品同时运行 NimBLE 和九个任务，LVGL 使用 410×20 RGB565 片内 DMA 单缓冲，释放 65.6 KiB 片内 RAM。
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=20
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# 不把全部 LVGL 热路径强制放入内部 IRAM；ESP32-S3 调试异常向量只有有限跳转范围，过多 LVGL 代码会导致链接器无法编码跳转。
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# 发布构建优先性能，同时保留 INFO 日志供首次烧录定位板型与自检失败。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 真板联调镜像把主控制台输出到板载 USB Serial/JTAG（COM10），便于在自检停机时读取稳定故障原因；不改变产品 BLE、模型或功耗状态。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 分区表保留 coredump 区供后续真机诊断版本使用；当前 MINIMAL_BUILD 未依赖 espcoredump 组件，因此不引用其条件 Kconfig 符号。
