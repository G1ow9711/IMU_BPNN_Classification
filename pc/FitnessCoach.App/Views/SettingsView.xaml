<UserControl x:Class="FitnessCoach.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设置页使用全高双列模块，让现有配置覆盖完整工作区而不增加虚假功能。 -->
    <Grid VerticalAlignment="Stretch">
        <!-- 两列分别承载训练基础和使用偏好。 -->
        <Grid.ColumnDefinitions>
            <!-- 设备与资料列。 -->
            <ColumnDefinition Width="*" />
            <!-- 显示与体验列。 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 设置卡占剩余高度，底部统一保存。 -->
        <Grid.RowDefinitions>
            <!-- 设置模块行。 -->
            <RowDefinition Height="*" />
            <!-- 保存状态行。 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左侧卡片包含连接模式、计量方式和训练资料。 -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,9,0">
            <!-- 标题固定在顶部，两个功能模块等高填充剩余空间。 -->
            <Grid>
                <!-- 标题、间距和两个功能模块分行。 -->
                <Grid.RowDefinitions>
                    <!-- 标题行按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 标题与模块间距。 -->
                    <RowDefinition Height="18" />
                    <!-- 连接和单位模块占一半剩余高度。 -->
                    <RowDefinition Height="*" />
                    <!-- 两模块间距。 -->
                    <RowDefinition Height="14" />
                    <!-- 体重和目标模块占另一半高度。 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 标题说明设置影响训练基础参数。 -->
                <StackPanel Grid.Row="0">
                    <!-- 分区标签。 -->
                    <TextBlock Text="设备与资料" Style="{StaticResource EyebrowTextStyle}" />
                    <!-- 分区主标题。 -->
                    <TextBlock Text="训练基础"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,5,0,4" />
                    <!-- 简短说明。 -->
                    <TextBlock Text="管理连接方式、计量单位和个人训练参数。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 连接与单位模块使用二级表面形成明确功能组。 -->
                <Border Grid.Row="2" Style="{StaticResource SubtleCardStyle}">
                    <!-- 内容垂直居中，避免模块顶部拥挤。 -->
                    <StackPanel VerticalAlignment="Center">
                        <!-- 模块标题。 -->
                        <TextBlock Text="连接与计量"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <!-- 真机蓝牙开关只在下次启动生效。 -->
                        <CheckBox Content="下次启动连接真机蓝牙"
                                  IsChecked="{Binding UseRealBleDevice}"
                                  Margin="0,0,0,14" />
                        <!-- 计量单位标签。 -->
                        <TextBlock Text="计量单位"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                        <!-- 单位选择只改变 PC 显示，协议继续使用规范千克。 -->
                        <ComboBox ItemsSource="{Binding UnitOptions}"
                                  SelectedItem="{Binding SelectedUnitOption}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 训练资料模块把体重和每日目标并排展示。 -->
                <Border Grid.Row="4" Style="{StaticResource SubtleCardStyle}">
                    <!-- 模块标题位于上方，两项输入在下方等宽排列。 -->
                    <Grid>
                        <!-- 标题按内容高度，输入区占剩余高度。 -->
                        <Grid.RowDefinitions>
                            <!-- 模块标题行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 输入区行。 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 模块标题。 -->
                        <TextBlock Grid.Row="0"
                                   Text="个人训练参数"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <!-- 体重与目标按两列排列。 -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,0">
                            <!-- 两项参数等宽。 -->
                            <Grid.ColumnDefinitions>
                                <!-- 体重列。 -->
                                <ColumnDefinition Width="*" />
                                <!-- 目标列。 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 体重输入区。 -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- 标签随公制或英制变化。 -->
                                <TextBlock Text="{Binding WeightInputLabel}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <!-- 输入值由 ViewModel 换算为规范千克。 -->
                                <TextBox Text="{Binding WeightDisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                            <!-- 每日目标输入区。 -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- 零值关闭目标。 -->
                                <TextBlock Text="每日能量目标（0 表示关闭）"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <!-- 目标单位为千卡。 -->
                                <TextBox Text="{Binding DailyCalorieGoal, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧卡片包含手表显示、声音、动画和开发者诊断。 -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource CardStyle}"
                Margin="9,0,0,0">
            <!-- 标题固定在顶部，显示和体验模块等高填充。 -->
            <Grid>
                <!-- 标题、间距和两个模块分行。 -->
                <Grid.RowDefinitions>
                    <!-- 标题行按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 标题与模块间距。 -->
                    <RowDefinition Height="18" />
                    <!-- 手表显示模块占一半剩余高度。 -->
                    <RowDefinition Height="*" />
                    <!-- 两模块间距。 -->
                    <RowDefinition Height="14" />
                    <!-- 反馈与辅助模块占另一半高度。 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 标题说明设置作用于手表和客户端。 -->
                <StackPanel Grid.Row="0">
                    <!-- 分区标签。 -->
                    <TextBlock Text="显示与体验" Style="{StaticResource EyebrowTextStyle}" />
                    <!-- 分区主标题。 -->
                    <TextBlock Text="使用偏好"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,5,0,4" />
                    <!-- 简短说明。 -->
                    <TextBlock Text="调整手表显示、提示音和客户端动作动画。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 手表显示模块把亮度和熄屏参数并排展示。 -->
                <Border Grid.Row="2" Style="{StaticResource SubtleCardStyle}">
                    <!-- 模块标题位于上方，两项输入在下方。 -->
                    <Grid>
                        <!-- 标题按内容高度，输入区占剩余高度。 -->
                        <Grid.RowDefinitions>
                            <!-- 模块标题行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 输入区行。 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 模块标题。 -->
                        <TextBlock Grid.Row="0"
                                   Text="手表显示"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <!-- 亮度与熄屏等宽排列。 -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,0">
                            <!-- 两项参数等宽。 -->
                            <Grid.ColumnDefinitions>
                                <!-- 亮度列。 -->
                                <ColumnDefinition Width="*" />
                                <!-- 熄屏列。 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 亮度输入区。 -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- 亮度合法范围。 -->
                                <TextBlock Text="亮度（5 到 100%）"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" />
                                <!-- 亮度保存后同步到已连接手表。 -->
                                <TextBox Text="{Binding BrightnessPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                            <!-- 熄屏输入区。 -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- 熄屏时长合法范围。 -->
                                <TextBlock Text="熄屏（10 到 300 秒）"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" />
                                <!-- 熄屏时长单位为秒。 -->
                                <TextBox Text="{Binding ScreenTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 反馈与辅助模块集中低频开关。 -->
                <Border Grid.Row="4" Style="{StaticResource SubtleCardStyle}">
                    <!-- 开关垂直居中，动画状态说明紧随对应开关。 -->
                    <StackPanel VerticalAlignment="Center">
                        <!-- 模块标题。 -->
                        <TextBlock Text="反馈与辅助"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <!-- 声音开关只表示提示音，不代表振动。 -->
                        <CheckBox Content="启用开始、目标和错误提示音"
                                  IsChecked="{Binding SoundEnabled}"
                                  Margin="0,0,0,10" />
                        <!-- 减少动画开关用于固定代表姿态。 -->
                        <CheckBox Content="本次运行减少动作动画"
                                  IsChecked="{Binding ReducedMotionEnabled}" />
                        <!-- 有效动画状态可能同时受 Windows 辅助功能控制。 -->
                        <TextBlock Text="{Binding ReducedMotionSummary}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="24,5,0,12" />
                        <!-- 开发者模式允许诊断页临时查看实时六轴。 -->
                        <CheckBox Content="开发者模式：允许查看实时诊断六轴"
                                  IsChecked="{Binding DeveloperModeEnabled}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部统一保存区避免两个设置分组各自产生主按钮。 -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#B9D6FF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14"
                Margin="0,18,0,0">
            <!-- 状态占剩余宽度，保存按钮按内容宽度。 -->
            <Grid>
                <!-- 状态和操作分列。 -->
                <Grid.ColumnDefinitions>
                    <!-- 状态消息列自适应。 -->
                    <ColumnDefinition Width="*" />
                    <!-- 保存按钮列按内容宽度。 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 设置结果明确区分本地保存和设备同步。 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />
                <!-- 唯一主按钮保存本地设置并在可用时同步设备。 -->
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="保存并同步"
                        Command="{Binding SaveCommand}"
                        MinWidth="132" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
