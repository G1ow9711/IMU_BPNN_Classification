<UserControl x:Class="FitnessCoach.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 历史页依次显示筛选工具栏、会话表格和选中详情。 -->
    <Grid>
        <!-- 三行布局保证小窗口中列表优先获得可伸缩空间。 -->
        <Grid.RowDefinitions>
            <!-- 筛选和导出工具栏按内容高度布局。 -->
            <RowDefinition Height="Auto" />
            <!-- 历史表格按实际记录使用有限高度，避免少量记录形成巨大空表格。 -->
            <RowDefinition Height="Auto" />
            <!-- 选中会话详情占用剩余空间。 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 筛选工具栏允许窄窗口横向滚动，避免控件被截断。 -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <!-- 日期、动作和操作按钮横向排列。 -->
            <StackPanel Orientation="Horizontal">
                <!-- 开始日期标签。 -->
                <TextBlock Text="开始日期" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <!-- 开始日期包含选中当天；清空表示不限制。 -->
                <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="135" Margin="8,0,14,0" />
                <!-- 结束日期标签。 -->
                <TextBlock Text="结束日期" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <!-- 结束日期包含选中当天。 -->
                <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="135" Margin="8,0,14,0" />
                <!-- 动作标签。 -->
                <TextBlock Text="动作" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <!-- 选择全部动作或 11 个正式动作之一。 -->
                <ComboBox ItemsSource="{Binding ActionFilters}"
                          SelectedItem="{Binding SelectedActionFilter, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="145"
                          Margin="8,0,14,0" />
                <!-- 应用当前日期和动作条件。 -->
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="筛选" Command="{Binding RefreshCommand}" />
                <!-- 恢复全部历史条件。 -->
                <Button Style="{StaticResource BaseButtonStyle}" Content="清空条件" Command="{Binding ClearFiltersCommand}" />
                <!-- 把当前筛选快照保存为逗号分隔值表格。 -->
                <Button Style="{StaticResource BaseButtonStyle}" Content="导出表格" Command="{Binding ExportCsvCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 历史记录只读表格；选择变化驱动下方详情面板。 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MinHeight="180"
                  MaxHeight="300"
                  VerticalAlignment="Top">
            <!-- 使用稳定显示列，原始数值仍保留在领域摘要中供表格导出使用。 -->
            <DataGrid.Columns>
                <!-- 会话开始时间列。 -->
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAtText}" Width="1.25*" />
                <!-- 动作摘要列。 -->
                <DataGridTextColumn Header="动作" Binding="{Binding ActionsText}" Width="1.5*" />
                <!-- 单调时长列。 -->
                <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="0.7*" />
                <!-- 总卡路里列。 -->
                <DataGridTextColumn Header="卡路里" Binding="{Binding CaloriesText}" Width="0.7*" />
                <!-- 设备标识列。 -->
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="1.15*" />
                <!-- 结束原因列。 -->
                <DataGridTextColumn Header="结束原因" Binding="{Binding EndReason}" Width="1.0*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态和选中会话详情使用剩余空间形成可扫读仪表板。 -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22"
                Margin="0,14,0,0">
            <!-- 状态条位于顶部，下方两列分别展示训练成果和会话信息。 -->
            <Grid>
                <!-- 状态按内容高度，详情占剩余高度。 -->
                <Grid.RowDefinitions>
                    <!-- 筛选和同步状态行。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 会话详情行。 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 显示筛选、同步和导出结果。 -->
                <TextBlock Grid.Row="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <!-- 训练成果与会话信息使用左右两列。 -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <!-- 成果列略宽，中央分隔线固定一像素。 -->
                    <Grid.ColumnDefinitions>
                        <!-- 训练成果列。 -->
                        <ColumnDefinition Width="1.05*" />
                        <!-- 中央分隔线。 -->
                        <ColumnDefinition Width="1" />
                        <!-- 会话信息列。 -->
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <!-- 左侧突出动作、时长和能量。 -->
                    <Grid Grid.Column="0" Margin="0,0,28,0">
                        <!-- 动作标题按内容高度，指标垂直居中。 -->
                        <Grid.RowDefinitions>
                            <!-- 标题行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 指标行。 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 选中会话标题。 -->
                        <StackPanel Grid.Row="0">
                            <!-- 分区标签。 -->
                            <TextBlock Text="选中会话" Style="{StaticResource EyebrowTextStyle}" />
                            <!-- 动作摘要允许显示多个动作，但正常单动作会话保持单行。 -->
                            <TextBlock Text="{Binding SelectedSession.ActionsText}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <!-- 时长和能量两项等宽排列。 -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <!-- 两项指标等宽。 -->
                            <Grid.ColumnDefinitions>
                                <!-- 时长列。 -->
                                <ColumnDefinition Width="*" />
                                <!-- 能量列。 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 时长指标。 -->
                            <StackPanel Grid.Column="0">
                                <!-- 指标名称。 -->
                                <TextBlock Text="训练时长" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <!-- 设备单调时长。 -->
                                <TextBlock Text="{Binding SelectedSession.DurationText}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <!-- 能量指标使用左分隔线。 -->
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    Padding="24,0">
                                <!-- 能量指标两级文字。 -->
                                <StackPanel>
                                    <!-- 指标名称。 -->
                                    <TextBlock Text="能量消耗" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <!-- 会话总千卡。 -->
                                    <TextBlock Text="{Binding SelectedSession.CaloriesText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- 中央细线分隔成果和会话来源。 -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BorderBrush}" />
                    <!-- 右侧会话元数据使用标签和值两列。 -->
                    <Grid Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center">
                        <!-- 标签列固定宽度，值列使用剩余空间。 -->
                        <Grid.ColumnDefinitions>
                            <!-- 标签列。 -->
                            <ColumnDefinition Width="78" />
                            <!-- 值列。 -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 四项元数据按内容高度排列。 -->
                        <Grid.RowDefinitions>
                            <!-- 开始时间行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 结束时间行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 设备行。 -->
                            <RowDefinition Height="Auto" />
                            <!-- 原因行。 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 开始时间。 -->
                        <TextBlock Grid.Row="0" Text="开始" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSession.StartedAtText}" FontWeight="SemiBold" Margin="0,7" />
                        <!-- 结束时间。 -->
                        <TextBlock Grid.Row="1" Text="结束" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.EndedAtText}" FontWeight="SemiBold" Margin="0,7" />
                        <!-- 来源设备。 -->
                        <TextBlock Grid.Row="2" Text="设备" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSession.DeviceId}" FontWeight="SemiBold" Margin="0,7" />
                        <!-- 会话结束原因。 -->
                        <TextBlock Grid.Row="3" Text="结束原因" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSession.EndReason}" FontWeight="SemiBold" Margin="0,7" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
