<UserControl x:Class="FitnessCoach.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FitnessCoach.App.Controls">
    <!-- 训练监测页使用单一仪表盘；1440×900 无滚动，较小窗口仍优先保留动作、指标和曲线。 -->
    <Grid MaxWidth="1240"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Margin="0,0,0,18">
        <!-- 上方动作与指标、下方两张曲线、底部质量条组成固定一页。 -->
        <Grid.RowDefinitions>
            <!-- 标准动作和关键指标使用固定高度，文字变化不会推动曲线。 -->
            <RowDefinition Height="250" />
            <!-- 曲线时间轴提供实时/历史切换，不占用训练主卡。 -->
            <RowDefinition Height="46" />
            <!-- 两张六轴曲线占用剩余空间。 -->
            <RowDefinition Height="*" MinHeight="210" />
            <!-- 曲线与状态条间距。 -->
            <RowDefinition Height="10" />
            <!-- 紧凑链路状态条。 -->
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!-- 首行三列分别承担示范、训练事实和连接控制。 -->
        <Grid Grid.Row="0">
            <!-- 中间训练事实略宽，连接控制保持紧凑。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="245" />
                <ColumnDefinition Width="1.25*" MinWidth="320" />
                <ColumnDefinition Width="0.85*" MinWidth="235" />
            </Grid.ColumnDefinitions>

            <!-- 标准动作示范只跟随设备三窗确认后的稳定动作。 -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="18"
                    Margin="0,0,6,0">
                <!-- 标题、教练人偶和动作说明使用固定三行。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 短标题不重复解释模型内部实现。 -->
                    <TextBlock Grid.Row="0"
                               Text="标准动作"
                               Style="{StaticResource EyebrowTextStyle}" />
                    <!-- 本地矢量教练人偶无需网络资源，动作变化才重置周期。 -->
                    <controls:ActionStickFigure Grid.Row="1"
                                                Action="{Binding CurrentAction}"
                                                AnimationRevision="{Binding AnimationRevision}"
                                                IsConnected="{Binding IsAnimationConnected}"
                                                ReducedMotion="{Binding ReducedMotion}"
                                                StrokeBrush="{StaticResource AccentBrush}"
                                                SecondaryBrush="{StaticResource SecondaryTextBrush}"
                                                Margin="0,2,0,0" />
                    <!-- 动作名称和佩戴要求集中在底部，帮助用户对照标准姿态。 -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <!-- 示范名称和设备稳定动作使用同一领域枚举。 -->
                        <TextBlock Text="{Binding StableActionText}"
                                   HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 单条标准姿态提示补充关节关系，不使用长篇教学文本。 -->
                        <TextBlock Text="{Binding StableActionCueText}"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                        <!-- 当前模型固定按右手腕域验收，提示不随动作切换。 -->
                        <TextBlock Text="右手腕佩戴"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 训练主卡突出当前动作、置信度和设备权威指标。 -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="20"
                    Margin="6,0">
                <!-- 四行固定信息避免高频分类改变布局。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 顶部状态行只承载设备状态和当前置信度。 -->
                        <RowDefinition Height="Auto" />
                        <!-- 稳定动作名称占据主视觉中心，不被诊断字段挤压。 -->
                        <RowDefinition Height="*" />
                        <!-- 三项权威累计固定在动作名称下方。 -->
                        <RowDefinition Height="Auto" />
                        <!-- 最底行保留双模型一致性短状态。 -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 状态与动作分区横向排列。 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 训练状态来自设备 LiveState。 -->
                        <TextBlock Text="{Binding DeviceStateText}"
                                   Style="{StaticResource EyebrowTextStyle}" />
                        <!-- 融合置信度是当前窗口事实，不使用插值动画。 -->
                        <Border Grid.Column="1"
                                Style="{StaticResource StatusPillStyle}"
                                Padding="10,4">
                            <TextBlock Text="{Binding FusedConfidenceText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <!-- 当前融合动作使用大字，单行截断保证指标位置稳定。 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding StableActionText}"
                               VerticalAlignment="Center"
                               FontSize="38"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <!-- 次数、时长和热量三项一眼可读。 -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <!-- 累计值使用左侧等宽槽。 -->
                            <ColumnDefinition Width="*" />
                            <!-- 时长使用中间等宽槽。 -->
                            <ColumnDefinition Width="*" />
                            <!-- 热量使用右侧等宽槽。 -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 当前次数或步数。 -->
                        <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="累计" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding MetricValue}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MetricUnitText}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 设备单调训练时长。 -->
                        <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="时长" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock Text="{Binding DurationText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- 设备权威热量。 -->
                        <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="消耗" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock Text="{Binding CaloriesText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 双模型摘要压缩为一行，保留诊断价值但不抢占主动作。 -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding ModelAgreementText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- 连接与采集控制卡只保留现场需要的四项事实和三项操作。 -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="18"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 卡片标题与在线状态。 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备链路" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontWeight="SemiBold" />
                    </Grid>
                    <!-- 只显示判断链路质量需要的短指标。 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RssiText}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AttMtuText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding RawSampleRateText}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding RawQualityText}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0">
                            <Run Text="样本  " />
                            <Run Text="{Binding RawSampleCountText, Mode=OneWay}" />
                        </TextBlock>
                        <!-- 导出状态只占一行；完整路径可通过悬停查看，避免压缩单页曲线区域。 -->
                        <TextBlock Text="{Binding ImuExportStatus}"
                                   ToolTip="{Binding ImuExportStatus}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <!-- 开关、暂停、导出和清空保持清晰文字，不使用难懂图标。 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <!-- 六轴开关获得剩余宽度，中文状态不会被截断。 -->
                            <ColumnDefinition Width="*" />
                            <!-- 暂停操作按内容宽度显示。 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 导出操作按内容宽度显示。 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 清空操作保持最小内容宽度。 -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{Binding RawStreamButtonText}"
                                Command="{Binding ToggleRawStreamCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,8"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="{Binding RawChartPauseButtonText}"
                                Command="{Binding PauseRawChartCommand}"
                                Padding="10,8"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="2"
                                Content="导出"
                                Command="{Binding ExportImuCsvCommand}"
                                ToolTip="实时导出全部缓存；暂停或回看时导出当前窗口"
                                Padding="10,8"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="3"
                                Content="清空"
                                Command="{Binding ClearRawChartCommand}"
                                Padding="10,8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 历史滑块只改变两张曲线的同步视口；RawStream 接收、分类和质量统计继续运行。 -->
        <Border Grid.Row="1"
                Style="{StaticResource SubtleCardStyle}"
                Padding="12,5"
                Margin="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 当前十秒视口使用紧凑文字显示实时或回看范围。 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 滑块占据剩余宽度，可浏览本次开启后的任意历史窗口。 -->
                    <ColumnDefinition Width="*" />
                    <!-- 缓存长度只显示时间，不堆叠协议说明。 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 一键回到实时端点，避免用户手动把滑块拖回零。 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 当前窗口范围来自设备单调时间，避免 PC 调度抖动改变横轴解释。 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding RawChartWindowText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0" />
                <!-- 滑块最大值随十分钟内存历史增长；向右拖动表示查看更早数据。 -->
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding RawChartMaximumOffsetSeconds}"
                        Value="{Binding RawChartOffsetSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsDirectionReversed="True"
                        VerticalAlignment="Center"
                        SmallChange="1"
                        LargeChange="10"
                        Margin="0,0,12,0" />
                <!-- 显示本次内存缓存长度和十分钟上限，明确数据没有写入磁盘。 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding RawChartHistoryText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <!-- 回到实时会解除冻结并发布最新十秒同步窗口。 -->
                <Button Grid.Column="3"
                        Content="回到实时"
                        Command="{Binding GoLiveRawChartCommand}"
                        Padding="12,5"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 最近十秒六轴数据并排显示，直接重绘样本而不做动画插值。 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 加速度和角速度共享相同横向面积，便于比较动作时序。 -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 三轴加速度。 -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,8">
                        <Run Text="加速度" FontSize="16" FontWeight="SemiBold" />
                        <Run Text="  ±2 倍重力   " Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                        <Run Text="横" Foreground="#25C7E8" FontWeight="SemiBold" />
                        <Run Text="  纵" Foreground="#FF9F2D" FontWeight="SemiBold" />
                        <Run Text="  垂" Foreground="#59D97A" FontWeight="SemiBold" />
                    </TextBlock>
                    <controls:ImuLineChart Grid.Row="1"
                                           Points="{Binding AccelerationPoints}"
                                           VerticalLimit="2" />
                </Grid>
            </Border>
            <!-- 三轴角速度。 -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,8">
                        <Run Text="角速度" FontSize="16" FontWeight="SemiBold" />
                        <Run Text="  ±250 度/秒   " Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                        <Run Text="横" Foreground="#25C7E8" FontWeight="SemiBold" />
                        <Run Text="  纵" Foreground="#FF9F2D" FontWeight="SemiBold" />
                        <Run Text="  垂" Foreground="#59D97A" FontWeight="SemiBold" />
                    </TextBlock>
                    <controls:ImuLineChart Grid.Row="1"
                                           Points="{Binding GyroscopePoints}"
                                           VerticalLimit="250" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态条保留分类性能、数据质量和协议错误，详细日志移出主视觉。 -->
        <Border Grid.Row="4"
                Style="{StaticResource SubtleCardStyle}"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding InferenceTimingText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding InferenceQualityText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="14,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ProtocolErrorText}"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
