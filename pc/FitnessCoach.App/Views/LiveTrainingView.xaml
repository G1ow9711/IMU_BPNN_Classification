<UserControl x:Class="FitnessCoach.App.Views.LiveTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FitnessCoach.App.Controls">
    <!-- 实时训练页使用单一训练舞台，减少碎片卡片对动作与次数的干扰。 -->
    <Border Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
        <!-- 页面按状态栏、训练主体和控制区分为三层。 -->
        <Grid>
            <!-- 三行分别承载会话状态、动作与次数、指标与控制。 -->
            <Grid.RowDefinitions>
                <!-- 状态栏高度由文字内容决定。 -->
                <RowDefinition Height="Auto" />
                <!-- 训练主体占用剩余空间。 -->
                <RowDefinition Height="*" />
                <!-- 底部指标和控制区按内容高度布局。 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部状态栏以轻量背景集中表达设备状态和识别可信度。 -->
            <Border Grid.Row="0"
                    Background="{StaticResource SubtleSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,15">
                <!-- 状态、置信度和佩戴域横向排列。 -->
                <Grid>
                    <!-- 左侧状态占剩余宽度，右侧信息按内容宽度。 -->
                    <Grid.ColumnDefinitions>
                        <!-- 设备状态列自适应。 -->
                        <ColumnDefinition Width="*" />
                        <!-- 置信度列按内容宽度。 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 佩戴模式列按内容宽度。 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 绿色状态点仅表示当前训练链路状态。 -->
                    <Ellipse Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                    <!-- 设备状态文本来自设备权威状态。 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding DeviceStateText}"
                               FontWeight="SemiBold"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <!-- 模型置信度作为辅助诊断信息，不与次数竞争字号。 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ConfidenceText, StringFormat=识别置信度 {0}}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="20,0"
                               VerticalAlignment="Center" />
                    <!-- 当前模型固定使用右手腕佩戴域。 -->
                    <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}">
                        <!-- 模式文字保持短小。 -->
                        <TextBlock Text="右手腕"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- 中部把标准姿态和实时累计放在同一视觉舞台。 -->
            <Grid Grid.Row="1" Margin="28,24,28,20">
                <!-- 动作示范略宽，计数区保持稳定最小宽度。 -->
                <Grid.ColumnDefinitions>
                    <!-- 动作示范占五成二宽度。 -->
                    <ColumnDefinition Width="1.05*" />
                    <!-- 中间分隔列固定宽度。 -->
                    <ColumnDefinition Width="1" />
                    <!-- 实时累计占四成八宽度。 -->
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧动作示范按名称、姿态和动作要点分行。 -->
                <Grid Grid.Column="0" Margin="0,0,28,0">
                    <!-- 标题和要点按内容高度，姿态区域自适应。 -->
                    <Grid.RowDefinitions>
                        <!-- 当前动作标题按内容高度。 -->
                        <RowDefinition Height="Auto" />
                        <!-- 教练人偶占用剩余空间。 -->
                        <RowDefinition Height="*" />
                        <!-- 动作要点按内容高度。 -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 当前动作区域提供小标签和稳定动作名称。 -->
                    <StackPanel Grid.Row="0">
                        <!-- 标签提示此处是设备确认的会话动作。 -->
                        <TextBlock Text="当前动作"
                                   Style="{StaticResource EyebrowTextStyle}" />
                        <!-- 动作名称使用足够字号，但低于次数。 -->
                        <TextBlock Text="{Binding ActionName}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <!-- 本地矢量教练人偶由 action_id 驱动，不加载网络或第三方媒体。 -->
                    <controls:ActionStickFigure Grid.Row="1"
                                                Action="{Binding CurrentAction}"
                                                AnimationRevision="{Binding AnimationRevision}"
                                                IsConnected="{Binding IsAnimationConnected}"
                                                ReducedMotion="{Binding ReducedMotion}"
                                                StrokeBrush="{StaticResource AccentBrush}"
                                                SecondaryBrush="{StaticResource SecondaryTextBrush}"
                                                MinHeight="230"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                    <!-- 动作要点放在浅色横条中，帮助用户快速校正姿态。 -->
                    <Border Grid.Row="2"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="10"
                            Padding="14,11">
                        <!-- 动作提示允许换行，避免长中文被裁剪。 -->
                        <TextBlock Text="{Binding ActionCueText}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <!-- 中央细分隔线建立层级，不再使用第二张大卡。 -->
                <Border Grid.Column="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,8" />

                <!-- 右侧集中显示累计值、单位和当前训练消息。 -->
                <Grid Grid.Column="2" Margin="32,0,0,0">
                    <!-- 累计值垂直居中，状态消息位于底部。 -->
                    <Grid.RowDefinitions>
                        <!-- 主指标占用剩余空间。 -->
                        <RowDefinition Height="*" />
                        <!-- 状态消息按内容高度。 -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 主指标垂直居中，形成训练时最强视觉焦点。 -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <!-- 指标标签说明数值含义。 -->
                        <TextBlock Text="本轮累计"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <!-- 数值和单位共享基线。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <!-- 权威累计值使用大号电蓝数字。 -->
                            <TextBlock Text="{Binding MetricValue}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="82"
                                       FontWeight="SemiBold"
                                       LineHeight="92" />
                            <!-- 次、步或秒单位靠近数字底部。 -->
                            <TextBlock Text="{Binding MetricUnit}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,0,18" />
                        </StackPanel>
                        <!-- 休息提示解释暂停计数语义，动作恢复后自动继续。 -->
                        <TextBlock Text="休息时保持当前动作，次数不会增加"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- 训练状态消息允许换行，避免错误信息被截断。 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </Grid>

            <!-- 底部区域使用一条分隔线承载三项指标和四个控制按钮。 -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,18">
                <!-- 指标位于左侧，控制按钮位于右侧。 -->
                <Grid>
                    <!-- 指标占剩余宽度，控制区按内容宽度。 -->
                    <Grid.ColumnDefinitions>
                        <!-- 三项指标使用剩余空间。 -->
                        <ColumnDefinition Width="*" />
                        <!-- 控制按钮按内容宽度。 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 时长、消耗和电量使用等宽分区，不再嵌套小卡片。 -->
                    <Grid Grid.Column="0" MaxWidth="520" HorizontalAlignment="Left">
                        <!-- 三项指标等宽排列。 -->
                        <Grid.ColumnDefinitions>
                            <!-- 时长指标列。 -->
                            <ColumnDefinition Width="*" />
                            <!-- 消耗指标列。 -->
                            <ColumnDefinition Width="*" />
                            <!-- 电量指标列。 -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 时长指标使用两级文字。 -->
                        <StackPanel Grid.Column="0">
                            <!-- 指标名称。 -->
                            <TextBlock Text="训练时长" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                            <!-- 指标值。 -->
                            <TextBlock Text="{Binding DurationText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- 消耗指标使用左边分隔线。 -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0">
                            <!-- 消耗指标两级文字。 -->
                            <StackPanel>
                                <!-- 指标名称。 -->
                                <TextBlock Text="能量消耗" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <!-- 指标值。 -->
                                <TextBlock Text="{Binding CaloriesText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- 电量指标使用左边分隔线。 -->
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="22,0">
                            <!-- 电量指标两级文字。 -->
                            <StackPanel>
                                <!-- 指标名称。 -->
                                <TextBlock Text="手表电量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <!-- 指标值。 -->
                                <TextBlock Text="{Binding BatteryText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 四个控制按钮保持稳定顺序和足够点击面积。 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 开始按钮是当前页主操作。 -->
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始训练" Command="{Binding StartCommand}" MinWidth="108" />
                        <!-- 暂停按钮保留训练上下文。 -->
                        <Button Content="暂停" Command="{Binding PauseCommand}" MinWidth="78" Margin="10,0,0,0" />
                        <!-- 恢复按钮继续当前会话。 -->
                        <Button Content="继续" Command="{Binding ResumeCommand}" MinWidth="78" Margin="10,0,0,0" />
                        <!-- 停止按钮结束并保存当前会话。 -->
                        <Button Style="{StaticResource DangerButtonStyle}" Content="结束" Command="{Binding StopCommand}" MinWidth="78" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
