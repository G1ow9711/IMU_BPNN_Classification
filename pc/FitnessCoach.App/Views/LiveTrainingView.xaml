<UserControl x:Class="FitnessCoach.App.Views.LiveTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FitnessCoach.App.Controls">
    <!-- 实时训练页使用两列布局：动作动画和实时指标。 -->
    <Grid>
        <!-- 左右两列在窄窗口下仍保留可读宽度。 -->
        <Grid.ColumnDefinitions>
            <!-- 动画列占较大宽度。 -->
            <ColumnDefinition Width="1.15*" />
            <!-- 指标列占剩余宽度。 -->
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <!-- 本地动作视觉卡片。 -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="28" Margin="0,0,18,0">
            <!-- 动作视觉垂直居中。 -->
            <Grid>
                <!-- 标题和动画分行。 -->
                <Grid.RowDefinitions>
                    <!-- 动作名称行。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 动画主体行。 -->
                    <RowDefinition Height="*" />
                    <!-- 状态提示行。 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 当前动作名称。 -->
                <TextBlock Grid.Row="0" Text="{Binding ActionName}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <!-- 纯 WPF 矢量火柴人由权威 action_id 与 AnimationRevision 驱动，不加载 GIF、Lottie 或网络资源。 -->
                <controls:ActionStickFigure Grid.Row="1"
                                            Action="{Binding CurrentAction}"
                                            AnimationRevision="{Binding AnimationRevision}"
                                            IsConnected="{Binding IsAnimationConnected}"
                                            ReducedMotion="{Binding ReducedMotion}"
                                            StrokeBrush="{StaticResource AccentBrush}"
                                            SecondaryBrush="{StaticResource SecondaryTextBrush}"
                                            MinHeight="280"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                <!-- 当前设备状态与减少动画状态使用文本提示，不用动态闪烁。 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <!-- 当前设备状态。 -->
                    <TextBlock Text="{Binding DeviceStateText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" HorizontalAlignment="Center" />
                    <!-- 辅助功能开启时显示静态姿态说明。 -->
                    <TextBlock Text="减少动画：固定关键姿态" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <!-- 默认隐藏说明。 -->
                        <TextBlock.Style>
                            <!-- 绑定 ReducedMotion 控制可见性，避免使用额外转换器。 -->
                            <Style TargetType="TextBlock">
                                <!-- 未减少动画时折叠说明。 -->
                                <Setter Property="Visibility" Value="Collapsed" />
                                <!-- true 时显示辅助功能状态。 -->
                                <Style.Triggers>
                                    <!-- 监听 ViewModel 的有效减少动画开关。 -->
                                    <DataTrigger Binding="{Binding ReducedMotion}" Value="True">
                                        <!-- 显示静态姿态说明。 -->
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧实时指标与控制。 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <!-- 指标卡片纵向排列。 -->
            <StackPanel>
                <!-- 当前计数主卡片。 -->
                <Border Background="#0A1110" BorderBrush="#16483A" BorderThickness="1" CornerRadius="14" Padding="22">
                    <!-- 计数垂直排列。 -->
                    <StackPanel>
                        <!-- 指标标签。 -->
                        <TextBlock Text="当前累计" Foreground="{StaticResource SecondaryTextBrush}" />
                        <!-- 数值和单位同行。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <!-- 权威累计值。 -->
                            <TextBlock Text="{Binding MetricValue}" Foreground="{StaticResource AccentBrush}" FontSize="52" FontWeight="Bold" />
                            <!-- 次、步或秒单位。 -->
                            <TextBlock Text="{Binding MetricUnit}" Foreground="{StaticResource AccentBrush}" FontSize="20" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 时长、卡路里和电量网格。 -->
                <Grid Margin="0,14,0,0">
                    <!-- 三列等宽。 -->
                    <Grid.ColumnDefinitions>
                        <!-- 时长列。 -->
                        <ColumnDefinition Width="*" />
                        <!-- 千卡列。 -->
                        <ColumnDefinition Width="*" />
                        <!-- 电量列。 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 时长卡片。 -->
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                        <!-- 时长文本组。 -->
                        <StackPanel>
                            <!-- 标签。 -->
                            <TextBlock Text="时长" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            <!-- 值。 -->
                            <TextBlock Text="{Binding DurationText}" FontSize="17" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 卡路里卡片。 -->
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="3,0">
                        <!-- 卡路里文本组。 -->
                        <StackPanel>
                            <!-- 标签。 -->
                            <TextBlock Text="消耗" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            <!-- 值。 -->
                            <TextBlock Text="{Binding CaloriesText}" FontSize="17" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 电量卡片。 -->
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                        <!-- 电量文本组。 -->
                        <StackPanel>
                            <!-- 标签。 -->
                            <TextBlock Text="电量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            <!-- 值。 -->
                            <TextBlock Text="{Binding BatteryText}" FontSize="17" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 置信度和电源提示。 -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                    <!-- 两项诊断纵向排列。 -->
                    <StackPanel>
                        <!-- 置信度。 -->
                        <TextBlock Text="{Binding ConfidenceText, StringFormat=置信度 {0}}" />
                        <!-- 电源合同状态。 -->
                        <TextBlock Text="{Binding PowerHint}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 四个控制按钮。 -->
                <WrapPanel Margin="0,16,0,0">
                    <!-- 开始按钮。 -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="开始" Command="{Binding StartCommand}" MinWidth="92" />
                    <!-- 暂停按钮。 -->
                    <Button Style="{StaticResource BaseButtonStyle}" Content="暂停" Command="{Binding PauseCommand}" MinWidth="92" />
                    <!-- 恢复按钮。 -->
                    <Button Style="{StaticResource BaseButtonStyle}" Content="恢复" Command="{Binding ResumeCommand}" MinWidth="92" />
                    <!-- 停止按钮。 -->
                    <Button Style="{StaticResource DangerButtonStyle}" Content="停止" Command="{Binding StopCommand}" MinWidth="92" />
                </WrapPanel>

                <!-- 状态消息允许换行。 -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="4,14,4,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
