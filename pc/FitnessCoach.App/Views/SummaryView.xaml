<UserControl x:Class="FitnessCoach.App.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 总结页按概要和动作明细两行布局。 -->
    <Grid>
        <!-- 顶部概要自适应，底部表格占剩余空间。 -->
        <Grid.RowDefinitions>
            <!-- 概要行。 -->
            <RowDefinition Height="Auto" />
            <!-- 明细行。 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 会话概要卡片。 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
            <!-- 每项占 360 像素并按可用宽度换行，防止目标与双端保存状态被窗口右边界裁掉。 -->
            <WrapPanel ItemWidth="360">
                <!-- 设备标识。 -->
                <TextBlock Text="{Binding DeviceId, StringFormat=设备：{0}}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 会话序号。 -->
                <TextBlock Text="{Binding SessionSequence, StringFormat=会话：#{0}}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 总时长。 -->
                <TextBlock Text="{Binding DurationText, StringFormat=时长：{0}}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 总千卡。 -->
                <TextBlock Text="{Binding CaloriesText, StringFormat=消耗：{0}}" Foreground="{StaticResource AccentBrush}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 显示当前每日千卡目标的完成值和百分比。 -->
                <TextBlock Text="{Binding GoalProgressText}" Foreground="{StaticResource AccentBrush}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 设备停止 ACK 表示设备端摘要已完成持久化。 -->
                <TextBlock Text="{Binding DeviceSaveStatus}" Foreground="{StaticResource SecondaryTextBrush}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- SessionCompleted 事件只在本地 JSON 保存成功后触发。 -->
                <TextBlock Text="{Binding LocalSaveStatus}" Foreground="{StaticResource SecondaryTextBrush}" Margin="8" FontSize="16" TextWrapping="Wrap" />
                <!-- 结束原因。 -->
                <TextBlock Text="{Binding EndReason, StringFormat=原因：{0}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="8" FontSize="16" TextWrapping="Wrap" />
            </WrapPanel>
        </Border>
        <!-- 动作明细表。 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="0,16,0,0">
            <!-- 固定列定义。 -->
            <DataGrid.Columns>
                <!-- 动作名称列。 -->
                <DataGridTextColumn Header="动作" Binding="{Binding ActionName}" Width="*" />
                <!-- 指标列。 -->
                <DataGridTextColumn Header="次数/步数/秒" Binding="{Binding MetricText}" Width="*" />
                <!-- 活动时长列。 -->
                <DataGridTextColumn Header="活动时长" Binding="{Binding DurationText}" Width="*" />
                <!-- 卡路里列。 -->
                <DataGridTextColumn Header="卡路里" Binding="{Binding CaloriesText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
