<Application x:Class="FitnessCoach.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FitnessCoach.App.ViewModels"
             xmlns:views="clr-namespace:FitnessCoach.App.Views">
    <!-- 全局资源定义阶段一上位机的视觉系统、交互反馈和页面映射。 -->
    <Application.Resources>
        <!-- 页面使用带轻微冷色的浅灰底，减少纯黑大面积造成的压迫。 -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FB" />
        <!-- 侧栏使用稳定石墨蓝，形成明确的应用导航区域。 -->
        <SolidColorBrush x:Key="SidebarBrush" Color="#101828" />
        <!-- 一级卡片使用白色表面，承载主要任务。 -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <!-- 二级表面用于列表、图表和只读信息块。 -->
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F8FAFC" />
        <!-- 分隔线使用低对比冷灰色，不与内容争夺注意力。 -->
        <SolidColorBrush x:Key="BorderBrush" Color="#E4EAF1" />
        <!-- 深色分隔线用于侧栏内部。 -->
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#27344A" />
        <!-- 主文字使用深石墨蓝，保证浅色背景可读性。 -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033" />
        <!-- 次文字使用中性蓝灰，表达说明和次要状态。 -->
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085" />
        <!-- 反色文字用于深色侧栏。 -->
        <SolidColorBrush x:Key="InverseTextBrush" Color="#F8FAFC" />
        <!-- 主强调色使用克制青蓝，统一连接、选择和关键动作。 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0F8FA8" />
        <!-- 强调色浅底用于选中、状态胶囊和辅助卡片。 -->
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F5F7" />
        <!-- 成功色只表示已连接、质量正常或模型有效。 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#159A71" />
        <!-- 成功浅底保证状态标签不依赖纯色文字。 -->
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F7F1" />
        <!-- 警告色表示需要注意但可恢复的状态。 -->
        <SolidColorBrush x:Key="WarningBrush" Color="#B54708" />
        <!-- 警告浅底用于开发者功能说明。 -->
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4E5" />
        <!-- 危险色只用于停止、忘记和不可恢复操作。 -->
        <SolidColorBrush x:Key="DangerBrush" Color="#D04444" />
        <!-- 危险浅底降低大面积红色的视觉噪声。 -->
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF0F0" />
        <!-- 图表区域使用深蓝黑，保持高频彩色曲线的对比度。 -->
        <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#0E1726" />

        <!-- 卡片阴影仅用于一级表面，模糊半径保持克制。 -->
        <DropShadowEffect x:Key="CardShadowEffect"
                          Color="#180F1F33"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.18" />

        <!-- 所有窗口使用浅色页面背景和中文优先字体。 -->
        <Style TargetType="Window">
            <!-- 设置应用页面底色。 -->
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <!-- 设置浅色页面默认文字。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 中文使用微软雅黑界面字体，数字回退到 Segoe UI。 -->
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <!-- 默认字号为十四像素，避免信息密度过高。 -->
            <Setter Property="FontSize" Value="14" />
            <!-- 使用设备像素对齐，提升细线和文字清晰度。 -->
            <Setter Property="UseLayoutRounding" Value="True" />
            <!-- 启用设备像素捕捉，减少半像素边框。 -->
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 普通文本继承深色主文字并使用理想排版模式。 -->
        <Style TargetType="TextBlock">
            <!-- 设置默认前景色。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 理想排版改善不同缩放比例下的中文字距。 -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <!-- 使用灰阶抗锯齿，避免彩色边缘。 -->
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        </Style>

        <!-- 页面眉标题用于卡片内的短分类标签。 -->
        <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
            <!-- 使用强调色表达当前业务分区。 -->
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <!-- 字号保持克制。 -->
            <Setter Property="FontSize" Value="12" />
            <!-- 半粗字重增强识别。 -->
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 卡片标题样式统一六个页面的一级信息层级。 -->
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <!-- 一级标题字号为二十像素。 -->
            <Setter Property="FontSize" Value="20" />
            <!-- 使用半粗字重，不采用过重黑体。 -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- 标题使用主文字色。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- 一级卡片样式统一圆角、边框、内边距和阴影。 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <!-- 卡片使用白色表面。 -->
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <!-- 卡片用冷灰细边框分隔。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 只使用一像素边框。 -->
            <Setter Property="BorderThickness" Value="1" />
            <!-- 统一十六像素圆角。 -->
            <Setter Property="CornerRadius" Value="16" />
            <!-- 统一二十四像素内边距。 -->
            <Setter Property="Padding" Value="24" />
            <!-- 一级卡片使用轻阴影。 -->
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <!-- 二级卡片用于状态摘要和密集信息。 -->
        <Style x:Key="SubtleCardStyle" TargetType="Border">
            <!-- 使用浅灰表面。 -->
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
            <!-- 使用同一分隔线。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 使用一像素边框。 -->
            <Setter Property="BorderThickness" Value="1" />
            <!-- 二级圆角略小。 -->
            <Setter Property="CornerRadius" Value="12" />
            <!-- 二级内容使用十六像素内边距。 -->
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- 状态胶囊只负责承载短状态文字，不使用循环动画。 -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <!-- 默认使用强调浅底。 -->
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <!-- 胶囊不使用显式边框。 -->
            <Setter Property="BorderThickness" Value="0" />
            <!-- 使用完整圆角。 -->
            <Setter Property="CornerRadius" Value="999" />
            <!-- 水平十二、垂直六像素内边距。 -->
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <!-- 默认按钮使用明确层级、焦点环和轻微按压反馈。 -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <!-- 按钮最小高度满足鼠标和触控。 -->
            <Setter Property="MinHeight" Value="42" />
            <!-- 水平十八、垂直九像素内边距。 -->
            <Setter Property="Padding" Value="18,9" />
            <!-- 外边距由具体布局控制，避免工具栏出现不一致空隙。 -->
            <Setter Property="Margin" Value="0" />
            <!-- 默认使用白色表面。 -->
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <!-- 默认使用主文字。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 默认边框使用冷灰色。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 只使用一像素边框。 -->
            <Setter Property="BorderThickness" Value="1" />
            <!-- 按钮使用半粗字重。 -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- 使用手型光标表达可点击。 -->
            <Setter Property="Cursor" Value="Hand" />
            <!-- 焦点由模板绘制，关闭系统默认虚线。 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 自定义模板提供圆角、焦点和按压缩放。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 模板绑定按钮资源，不改变业务命令。 -->
                    <ControlTemplate TargetType="Button">
                        <!-- 根网格承担 0.98 按压缩放，避免改变布局尺寸。 -->
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <!-- 缩放只作用于合成阶段。 -->
                            <Grid.RenderTransform>
                                <!-- 默认比例为一。 -->
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <!-- 圆角边框承载按钮内容。 -->
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <!-- 按模板对齐方式显示文字或自定义内容。 -->
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <!-- 键盘焦点环位于按钮内部，不引发布局变化。 -->
                            <Border x:Name="FocusRing"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <!-- 触发器提供悬停、按压、键盘焦点和禁用反馈。 -->
                        <ControlTemplate.Triggers>
                            <!-- 悬停时只改变表面和边框，不移动按钮。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 使用浅青色背景。 -->
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <!-- 使用主强调色边框。 -->
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <!-- 按下时进行轻微合成缩放，形成 Press / Tap feedback。 -->
                            <Trigger Property="IsPressed" Value="True">
                                <!-- 用完整缩放变换同时把横纵比例缩小到 0.98，避免触发布局重排。 -->
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <!-- 变换只影响按钮合成结果。 -->
                                    <Setter.Value>
                                        <!-- 横纵比例保持一致，避免文字拉伸。 -->
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                                <!-- 同时轻微降低透明度。 -->
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <!-- 键盘焦点显示明确双像素焦点环。 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <!-- 显示焦点环。 -->
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <!-- 禁用时降低对比度并恢复箭头光标。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- 降低整体透明度。 -->
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                                <!-- 使用普通箭头避免暗示可点击。 -->
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 未显式指定样式的按钮也使用统一基础模板。 -->
        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <!-- 主操作按钮使用青蓝填充和白色文字。 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <!-- 主强调色背景。 -->
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <!-- 白色文字保证对比度。 -->
            <Setter Property="Foreground" Value="#FFFFFF" />
            <!-- 边框与背景一致。 -->
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- 次操作按钮使用浅青表面。 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <!-- 使用强调浅底。 -->
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <!-- 使用强调色文字。 -->
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <!-- 使用浅色边框。 -->
            <Setter Property="BorderBrush" Value="#B8DDE3" />
        </Style>

        <!-- 危险按钮使用浅红底和红色文字。 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <!-- 使用危险浅底。 -->
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <!-- 使用危险色文字。 -->
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <!-- 使用低饱和红边框。 -->
            <Setter Property="BorderBrush" Value="#F2B8B8" />
        </Style>

        <!-- 侧栏导航按钮保持左对齐、透明底和充足高度。 -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <!-- 内容左对齐。 -->
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <!-- 导航按钮占满侧栏宽度。 -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <!-- 导航默认透明。 -->
            <Setter Property="Background" Value="Transparent" />
            <!-- 导航默认无可见边框。 -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- 反色文字适配深色侧栏。 -->
            <Setter Property="Foreground" Value="#D0D5DD" />
            <!-- 导航按钮使用十二像素圆角。 -->
            <Setter Property="MinHeight" Value="48" />
            <!-- 导航内边距略大。 -->
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <!-- 输入框使用白色表面和清晰焦点边框。 -->
        <Style TargetType="TextBox">
            <!-- 使用白色输入背景。 -->
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <!-- 输入文字使用主文字色。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 输入边框使用冷灰色。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 使用一像素边框。 -->
            <Setter Property="BorderThickness" Value="1" />
            <!-- 设置舒适内边距。 -->
            <Setter Property="Padding" Value="12,8" />
            <!-- 输入最小高度为四十像素。 -->
            <Setter Property="MinHeight" Value="40" />
            <!-- 文本垂直居中。 -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- 焦点时使用主色边框。 -->
            <Style.Triggers>
                <!-- 监听键盘焦点。 -->
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <!-- 使用强调色边框。 -->
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 下拉框使用与输入框一致的尺寸和表面。 -->
        <Style TargetType="ComboBox">
            <!-- 使用白色表面。 -->
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <!-- 使用主文字色。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 使用统一边框。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 设定最小高度。 -->
            <Setter Property="MinHeight" Value="40" />
            <!-- 使用十像素内边距。 -->
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <!-- 复选框使用主文字和一致纵向间距。 -->
        <Style TargetType="CheckBox">
            <!-- 使用主文字色。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 设置上下间距。 -->
            <Setter Property="Margin" Value="0,8" />
            <!-- 保持内容可读。 -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 列表框使用浅色表面。 -->
        <Style TargetType="ListBox">
            <!-- 使用次级表面背景。 -->
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
            <!-- 使用统一边框。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 使用一像素边框。 -->
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 表格采用浅色只读视觉和明确行高。 -->
        <Style TargetType="DataGrid">
            <!-- 表格背景使用白色。 -->
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <!-- 表格文字使用主文字。 -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- 外边框使用冷灰色。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 横向网格线保持低对比。 -->
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <!-- 不显示纵向网格线，降低表格噪声。 -->
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <!-- 只显示列头。 -->
            <Setter Property="HeadersVisibility" Value="Column" />
            <!-- 禁止新增行。 -->
            <Setter Property="CanUserAddRows" Value="False" />
            <!-- 表格只读。 -->
            <Setter Property="IsReadOnly" Value="True" />
            <!-- 禁止自动生成列。 -->
            <Setter Property="AutoGenerateColumns" Value="False" />
            <!-- 行高保证信息易扫读。 -->
            <Setter Property="RowHeight" Value="44" />
            <!-- 列头高度统一。 -->
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <!-- 行背景保持白色。 -->
            <Setter Property="RowBackground" Value="{StaticResource CardBrush}" />
            <!-- 交替行使用次级表面。 -->
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleSurfaceBrush}" />
        </Style>

        <!-- 表格列头使用浅灰背景和次文字色。 -->
        <Style TargetType="DataGridColumnHeader">
            <!-- 列头使用次级表面。 -->
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
            <!-- 列头文字使用次文字色。 -->
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <!-- 使用半粗字重。 -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- 左右十二像素内边距。 -->
            <Setter Property="Padding" Value="12,8" />
            <!-- 列头底边使用统一分隔线。 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <!-- 只保留底边。 -->
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- 设备 ViewModel 映射到设备页。 -->
        <DataTemplate DataType="{x:Type viewModels:DeviceViewModel}">
            <!-- 实例化设备页。 -->
            <views:DeviceView />
        </DataTemplate>
        <!-- 实时 ViewModel 映射到训练页。 -->
        <DataTemplate DataType="{x:Type viewModels:LiveTrainingViewModel}">
            <!-- 实例化实时训练页。 -->
            <views:LiveTrainingView />
        </DataTemplate>
        <!-- 总结 ViewModel 映射到总结页。 -->
        <DataTemplate DataType="{x:Type viewModels:SummaryViewModel}">
            <!-- 实例化总结页。 -->
            <views:SummaryView />
        </DataTemplate>
        <!-- 历史 ViewModel 映射到历史页。 -->
        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <!-- 实例化历史页。 -->
            <views:HistoryView />
        </DataTemplate>
        <!-- 设置 ViewModel 映射到设置页。 -->
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <!-- 实例化设置页。 -->
            <views:SettingsView />
        </DataTemplate>
        <!-- 诊断 ViewModel 映射到诊断页。 -->
        <DataTemplate DataType="{x:Type viewModels:DiagnosticsViewModel}">
            <!-- 实例化诊断页。 -->
            <views:DiagnosticsView />
        </DataTemplate>
    </Application.Resources>
</Application>
