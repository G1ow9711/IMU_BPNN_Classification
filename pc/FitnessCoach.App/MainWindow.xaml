<Window x:Class="FitnessCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手腕健身动作助手"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <!-- 主窗口由固定侧栏和自适应内容区组成。 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- 第一列固定导航宽度，第二列占用剩余空间。 -->
        <Grid.ColumnDefinitions>
            <!-- 侧栏固定 220 像素。 -->
            <ColumnDefinition Width="220" />
            <!-- 内容区自动伸展。 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航使用接近纯黑的卡片色。 -->
        <Border Grid.Column="0" Background="#080808" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <!-- 导航内容上下排列。 -->
            <DockPanel Margin="16">
                <!-- 底部提示应用支持模拟设备与真机蓝牙，两种模式由设置页选择。 -->
                <Border DockPanel.Dock="Bottom" Background="#121212" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <!-- 模式提示允许换行，实际当前模式在设备页和诊断页显示。 -->
                    <TextBlock Text="设备模式&#10;模拟设备 / 真机蓝牙" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- 顶部品牌区。 -->
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28">
                    <!-- 应用主标题。 -->
                    <TextBlock Text="健身助手" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" />
                    <!-- 应用副标题。 -->
                    <TextBlock Text="手腕动作识别" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                </StackPanel>

                <!-- 六个导航按钮。 -->
                <StackPanel>
                    <!-- 设备页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="●  设备" Command="{Binding ShowDeviceCommand}" />
                    <!-- 实时训练页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="▶  实时训练" Command="{Binding ShowLiveTrainingCommand}" />
                    <!-- 训练总结页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="✓  训练总结" Command="{Binding ShowSummaryCommand}" />
                    <!-- 历史页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="▤  历史记录" Command="{Binding ShowHistoryCommand}" />
                    <!-- 设置页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="⚙  设置" Command="{Binding ShowSettingsCommand}" />
                    <!-- 诊断页。 -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="◇  诊断" Command="{Binding ShowDiagnosticsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容区。 -->
        <Grid Grid.Column="1" Margin="32,24,32,28">
            <!-- 顶部标题与页面内容分行。 -->
            <Grid.RowDefinitions>
                <!-- 标题行自适应高度。 -->
                <RowDefinition Height="Auto" />
                <!-- 内容行占剩余空间。 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 当前页面标题。 -->
            <TextBlock Grid.Row="0" Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22" />
            <!-- 根据 CurrentPage 运行时类型选择 App.xaml DataTemplate。 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
