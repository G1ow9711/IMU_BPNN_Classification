<Window x:Class="FitnessCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手腕健身动作助手"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <!-- 主窗口用深色任务导航和浅色工作区建立稳定空间关系。 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- 左侧导航固定宽度，右侧工作区占用剩余空间。 -->
        <Grid.ColumnDefinitions>
            <!-- 侧栏宽度容纳完整中文导航和训练模式说明。 -->
            <ColumnDefinition Width="252" />
            <!-- 主工作区自适应窗口。 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 深色侧栏只承载品牌、导航和当前连接摘要。 -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <!-- 四行分别放品牌、训练模式、导航和底部设备状态。 -->
            <Grid Margin="20,24,20,20">
                <!-- 固定品牌和状态高度，中间导航伸展。 -->
                <Grid.RowDefinitions>
                    <!-- 品牌区按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 训练模式说明按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 导航占剩余高度。 -->
                    <RowDefinition Height="*" />
                    <!-- 连接摘要按内容高度。 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌区使用简洁字标，不加载装饰图片。 -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <!-- 小标题标识产品类别。 -->
                    <TextBlock Text="腕上智能训练"
                               Foreground="#7DD3E2"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <!-- 产品主标题。 -->
                    <TextBlock Text="健身动作助手"
                               Foreground="{StaticResource InverseTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                    <!-- 产品说明。 -->
                    <TextBlock Text="六轴采集与动作识别"
                               Foreground="#98A2B3"
                               FontSize="13"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- 训练模式卡只呈现用户需要遵循的右腕单动作规则。 -->
                <Border Grid.Row="1"
                        Background="#19263A"
                        BorderBrush="#2F415B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,22">
                    <!-- 训练模式信息纵向排列。 -->
                    <StackPanel>
                        <!-- 模式类别使用浅青色。 -->
                        <TextBlock Text="训练模式"
                                   Foreground="#7DD3E2"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <!-- 佩戴域和会话合同使用反色主文字。 -->
                        <TextBlock Text="右手腕 / 单动作"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                        <!-- 说明一次训练只做一种动作，避免模型跨动作切换。 -->
                        <TextBlock Text="点击开始后，只做一种动作"
                                   Foreground="#98A2B3"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- 六个导航项使用简洁中文名称，当前页由背景、边框和文字共同标识。 -->
                <StackPanel Grid.Row="2">
                    <!-- 设备导航项。 -->
                    <Button Command="{Binding ShowDeviceCommand}" Margin="0,0,0,6">
                        <!-- 每个导航项独立绑定自己的选中事实。 -->
                        <Button.Style>
                            <!-- 基于全局导航样式。 -->
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <!-- 设备页选中时使用深青表面和白字。 -->
                                <Style.Triggers>
                                    <!-- 监听设备页选中状态。 -->
                                    <DataTrigger Binding="{Binding IsDeviceSelected}" Value="True">
                                        <!-- 显示选中背景。 -->
                                        <Setter Property="Background" Value="#173B46" />
                                        <!-- 显示青色边框。 -->
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <!-- 使用反色文字。 -->
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称不使用工程编号，减少侧栏视觉噪声。 -->
                        <TextBlock Text="设备" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>

                    <!-- 实时训练导航项。 -->
                    <Button Command="{Binding ShowLiveTrainingCommand}" Margin="0,0,0,6">
                        <!-- 根据实时页选中状态改变表面。 -->
                        <Button.Style>
                            <!-- 复用导航基础样式。 -->
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <!-- 监听实时页选中状态。 -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveTrainingSelected}" Value="True">
                                        <Setter Property="Background" Value="#173B46" />
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称保持单行，选中态由按钮样式表达。 -->
                        <TextBlock Text="实时训练" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>

                    <!-- 训练总结导航项。 -->
                    <Button Command="{Binding ShowSummaryCommand}" Margin="0,0,0,6">
                        <!-- 根据总结页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSummarySelected}" Value="True">
                                        <Setter Property="Background" Value="#173B46" />
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称保持单行，避免编号与页面内容争夺焦点。 -->
                        <TextBlock Text="训练总结" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>

                    <!-- 历史记录导航项。 -->
                    <Button Command="{Binding ShowHistoryCommand}" Margin="0,0,0,6">
                        <!-- 根据历史页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistorySelected}" Value="True">
                                        <Setter Property="Background" Value="#173B46" />
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称保持单行，使用成熟应用常见文字导航。 -->
                        <TextBlock Text="历史记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>

                    <!-- 设置导航项。 -->
                    <Button Command="{Binding ShowSettingsCommand}" Margin="0,0,0,6">
                        <!-- 根据设置页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                                        <Setter Property="Background" Value="#173B46" />
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称保持单行。 -->
                        <TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>

                    <!-- 诊断导航项。 -->
                    <Button Command="{Binding ShowDiagnosticsCommand}" Margin="0,0,0,6">
                        <!-- 根据诊断页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiagnosticsSelected}" Value="True">
                                        <Setter Property="Background" Value="#173B46" />
                                        <Setter Property="BorderBrush" Value="#2A8398" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 导航名称保持单行。 -->
                        <TextBlock Text="训练监测" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>

                <!-- 底部设备摘要复用设备页权威连接状态。 -->
                <Border Grid.Row="3"
                        Background="#162235"
                        BorderBrush="#27364D"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <!-- 连接摘要垂直排列。 -->
                    <StackPanel>
                        <!-- 状态类别。 -->
                        <TextBlock Text="当前设备"
                                   Foreground="#98A2B3"
                                   FontSize="11" />
                        <!-- 权威连接状态。 -->
                        <TextBlock Text="{Binding Device.ConnectionStatus}"
                                   Foreground="#7DD3E2"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <!-- 当前设备标识经过展示层本地化。 -->
                        <TextBlock Text="{Binding Device.DeviceIdText}"
                                   Foreground="#D0D5DD"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧浅色工作区承载页面标题和当前页面。 -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <!-- 标题区固定高度，内容区自适应。 -->
            <Grid.RowDefinitions>
                <!-- 标题按内容高度。 -->
                <RowDefinition Height="Auto" />
                <!-- 页面主体占剩余空间。 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页面标题和产品模式状态横向排列。 -->
            <Grid Grid.Row="0" Margin="34,28,34,20">
                <!-- 标题占剩余宽度，状态胶囊按内容宽度。 -->
                <Grid.ColumnDefinitions>
                    <!-- 标题列自适应。 -->
                    <ColumnDefinition Width="*" />
                    <!-- 状态列按内容宽度。 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 标题和副标题形成两级信息。 -->
                <StackPanel Grid.Column="0">
                    <!-- 当前页面标题。 -->
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <!-- 当前页面任务说明。 -->
                    <TextBlock Text="{Binding PageSubtitle}"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <!-- 右侧模式胶囊持续提醒当前模型的右腕佩戴域。 -->
                <Border Grid.Column="1"
                        Style="{StaticResource StatusPillStyle}"
                        VerticalAlignment="Center">
                    <!-- 胶囊文字不使用动态图标或内部开发阶段编号。 -->
                            <TextBlock Text="右手腕模式"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
            </Grid>

            <!-- 当前页面内容保留页面自己的滚动和布局策略。 -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="34,0,34,30"
                            ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>
