<Window x:Class="FitnessCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESP32智慧运动助手"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <!-- 主窗口用深色任务导航和浅色工作区建立稳定空间关系。 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- 左侧导航固定宽度，右侧工作区占用剩余空间。 -->
        <Grid.ColumnDefinitions>
            <!-- 侧栏宽度容纳完整中文导航和训练模式说明。 -->
            <ColumnDefinition Width="264" />
            <!-- 主工作区自适应窗口。 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 深色侧栏只承载品牌、导航和当前连接摘要。 -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <!-- 四行分别放品牌、训练模式、导航和底部设备状态。 -->
            <Grid Margin="18,22,18,18">
                <!-- 固定品牌和状态高度，中间导航伸展。 -->
                <Grid.RowDefinitions>
                    <!-- 品牌区按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 训练模式说明按内容高度。 -->
                    <RowDefinition Height="Auto" />
                    <!-- 导航占剩余高度。 -->
                    <RowDefinition Height="*" />
                    <!-- 连接摘要按内容高度。 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌区使用本地字标和单一产品名称，不依赖外部图片。 -->
                <Grid Grid.Row="0" Margin="4,0,4,24">
                    <!-- 左侧品牌标和右侧文字按内容分列。 -->
                    <Grid.ColumnDefinitions>
                        <!-- 品牌标固定尺寸，保证页面切换时顶栏不跳动。 -->
                        <ColumnDefinition Width="46" />
                        <!-- 产品文字使用剩余宽度。 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- ESP32 品牌标使用单一电蓝表面。 -->
                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <!-- “32”直接表达 ESP32 平台，避免含义不明的装饰图形。 -->
                        <TextBlock Text="32"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <!-- 产品名称和用途说明组成稳定两级品牌。 -->
                    <StackPanel Grid.Column="1" Margin="10,1,0,0">
                        <!-- 主品牌使用完整用户指定名称。 -->
                        <TextBlock Text="ESP32智慧运动助手"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <!-- 产品说明只表达用户价值，不展示内部模型信息。 -->
                        <TextBlock Text="智能识别与实时计数"
                                   Foreground="#8FA0B8"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 训练模式卡只呈现用户需要遵循的右腕单动作规则。 -->
                <Border Grid.Row="1"
                        Background="#111D2F"
                        BorderBrush="#253551"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                         Margin="0,0,0,20">
                    <!-- 训练模式信息纵向排列。 -->
                    <StackPanel>
                        <!-- 模式类别使用浅青色。 -->
                        <TextBlock Text="训练模式"
                                   Foreground="#69A7FF"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <!-- 佩戴域和会话合同使用反色主文字。 -->
                        <TextBlock Text="右手腕 / 单动作"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                        <!-- 说明一次训练只做一种动作，避免模型跨动作切换。 -->
                         <TextBlock Text="休息不计数，恢复后自动继续"
                                   Foreground="#98A2B3"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- 六个导航项使用简洁中文名称，当前页由背景、边框和文字共同标识。 -->
                <StackPanel Grid.Row="2">
                    <!-- 设备导航项。 -->
                    <Button Command="{Binding ShowDeviceCommand}" Margin="0,0,0,6">
                        <!-- 每个导航项独立绑定自己的选中事实。 -->
                        <Button.Style>
                            <!-- 基于全局导航样式。 -->
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <!-- 设备页选中时使用深青表面和白字。 -->
                                <Style.Triggers>
                                    <!-- 监听设备页选中状态。 -->
                                    <DataTrigger Binding="{Binding IsDeviceSelected}" Value="True">
                                        <!-- 显示选中背景。 -->
                                        <Setter Property="Background" Value="#16345E" />
                                        <!-- 显示青色边框。 -->
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <!-- 使用反色文字。 -->
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 系统图标与文字构成可快速扫描的导航项。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 设备图标使用 Windows 系统字体，不引入第三方图标资源。 -->
                            <TextBlock Text="&#xE772;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="设备" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 实时训练导航项。 -->
                    <Button Command="{Binding ShowLiveTrainingCommand}" Margin="0,0,0,6">
                        <!-- 根据实时页选中状态改变表面。 -->
                        <Button.Style>
                            <!-- 复用导航基础样式。 -->
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <!-- 监听实时页选中状态。 -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveTrainingSelected}" Value="True">
                                        <Setter Property="Background" Value="#16345E" />
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 图标和文字同时表达实时训练入口。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 播放图标表达开始训练。 -->
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="实时训练" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 训练总结导航项。 -->
                    <Button Command="{Binding ShowSummaryCommand}" Margin="0,0,0,6">
                        <!-- 根据总结页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSummarySelected}" Value="True">
                                        <Setter Property="Background" Value="#16345E" />
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 图标和文字同时表达训练总结入口。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 完成图标表达本轮训练结果。 -->
                            <TextBlock Text="&#xE930;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="训练总结" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 历史记录导航项。 -->
                    <Button Command="{Binding ShowHistoryCommand}" Margin="0,0,0,6">
                        <!-- 根据历史页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistorySelected}" Value="True">
                                        <Setter Property="Background" Value="#16345E" />
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 图标和文字同时表达历史入口。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 历史图标表达过去训练记录。 -->
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="历史记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 设置导航项。 -->
                    <Button Command="{Binding ShowSettingsCommand}" Margin="0,0,0,6">
                        <!-- 根据设置页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                                        <Setter Property="Background" Value="#16345E" />
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 图标和文字同时表达设置入口。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 齿轮图标表达产品设置。 -->
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 诊断导航项。 -->
                    <Button Command="{Binding ShowDiagnosticsCommand}" Margin="0,0,0,6">
                        <!-- 根据诊断页选中状态改变表面。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiagnosticsSelected}" Value="True">
                                        <Setter Property="Background" Value="#16345E" />
                                        <Setter Property="BorderBrush" Value="#2F80ED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 图标和文字同时表达训练监测入口。 -->
                        <StackPanel Orientation="Horizontal">
                            <!-- 波形图标表达实时诊断和传感器监测。 -->
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <!-- 导航名称保持单行。 -->
                            <TextBlock Text="训练监测" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 底部设备摘要复用设备页权威连接状态。 -->
                <Border Grid.Row="3"
                        Background="#111D2F"
                        BorderBrush="#253551"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <!-- 连接摘要垂直排列。 -->
                    <StackPanel>
                        <!-- 状态类别。 -->
                        <TextBlock Text="当前设备"
                                   Foreground="#98A2B3"
                                   FontSize="11" />
                        <!-- 权威连接状态。 -->
                        <TextBlock Text="{Binding Device.ConnectionStatus}"
                                   Foreground="#69A7FF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <!-- 当前设备标识经过展示层本地化。 -->
                        <TextBlock Text="{Binding Device.DeviceIdText}"
                                   Foreground="#D0D5DD"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧浅色工作区承载页面标题和当前页面。 -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <!-- 标题区固定高度，内容区自适应。 -->
            <Grid.RowDefinitions>
                <!-- 标题按内容高度。 -->
                <RowDefinition Height="Auto" />
                <!-- 页面主体占剩余空间。 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页面标题和产品模式状态横向排列。 -->
            <Grid Grid.Row="0" Margin="36,28,36,20">
                <!-- 标题占剩余宽度，状态胶囊按内容宽度。 -->
                <Grid.ColumnDefinitions>
                    <!-- 标题列自适应。 -->
                    <ColumnDefinition Width="*" />
                    <!-- 状态列按内容宽度。 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 标题和副标题形成两级信息。 -->
                <StackPanel Grid.Column="0">
                    <!-- 当前页面标题。 -->
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <!-- 当前页面任务说明。 -->
                    <TextBlock Text="{Binding PageSubtitle}"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <!-- 右侧模式胶囊持续提醒当前模型的右腕佩戴域。 -->
                <Border Grid.Column="1"
                        Style="{StaticResource StatusPillStyle}"
                        VerticalAlignment="Center">
                    <!-- 胶囊文字不使用动态图标或内部开发阶段编号。 -->
                            <TextBlock Text="右手腕模式"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
            </Grid>

            <!-- 当前页面内容保留页面自己的滚动和布局策略。 -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="36,0,36,30"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>
